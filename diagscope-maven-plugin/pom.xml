<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.diagscope</groupId>
        <artifactId>diagscope-parent</artifactId>
        <version>0.1.8</version>
    </parent>
    <artifactId>diagscope-maven-plugin</artifactId>
    <packaging>maven-plugin</packaging>
    <name>DiagScope Maven Plugin</name>
    <description>Runs DiagScope during a Maven build and fails it according to a configurable gate.</description>

    <properties>
        <maven.api.version>3.9.9</maven.api.version>
        <maven.plugin.tools.version>3.15.2</maven.plugin.tools.version>
    </properties>

    <dependencies>
        <!-- The CLI jar is shaded: it already carries the analyzer, the parsers, Jackson and Picocli, so nothing else is
             pulled in. The plugin only calls its public embedding entry point, ScanWorkflow. -->
        <dependency>
            <groupId>io.github.diagscope</groupId>
            <artifactId>diagscope-cli</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
            </exclusions>
        </dependency>
        <!-- Compile-time only: the shaded CLI jar carries these classes at run time, and the reactor resolves the CLI to
             its class directory (without core) before the jar exists. -->
        <dependency>
            <groupId>io.github.diagscope</groupId>
            <artifactId>diagscope-core</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>${maven.api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <version>${maven.api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <version>${maven.plugin.tools.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>io.github.diagscope</groupId>
            <artifactId>diagscope-test-fixtures</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <version>${maven.plugin.tools.version}</version>
                <configuration>
                    <goalPrefix>diagscope</goalPrefix>
                </configuration>
                <executions>
                    <execution>
                        <id>default-descriptor</id>
                        <phase>process-classes</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
