<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.diagscope</groupId>
        <artifactId>diagscope-parent</artifactId>
        <version>0.1.0-alpha.1-SNAPSHOT</version>
    </parent>
    <artifactId>diagscope-kotlinparser</artifactId>
    <name>DiagScope Kotlin Parser Adapter</name>

    <dependencies>
        <dependency>
            <groupId>dev.diagscope</groupId>
            <artifactId>diagscope-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.diagscope</groupId>
            <artifactId>diagscope-jvmanalysis</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-compiler-embeddable</artifactId>
        </dependency>
        <!-- PSI signatures expose Kotlin and JetBrains annotation types at Java compile time. -->
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.diagscope</groupId>
            <artifactId>diagscope-test-fixtures</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive><manifestEntries><Automatic-Module-Name>dev.diagscope.kotlinparser</Automatic-Module-Name></manifestEntries></archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
